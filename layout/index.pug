extends includes/layout.pug

block content
  #recent-posts.recent-posts.nc.home-card-page
    .post-card-grid
      each article in page.posts.data
        - const title = article.title || _p('no_title')
        - const link = article.link || article.path
        - const cover = article.cover || theme.default_top_img || theme.index_img
        - const descHtml = postDesc(article) || ''
        - const descText = strip_html(descHtml).replace(/\s+/g, ' ').trim()
        - const summary = descText ? descText.slice(0, 76) : title
        a.post-card(href=url_for(link) title=title)
          .post-card__media
            if cover
              if article.cover_type === 'img' || !article.cover_type
                img.post-card__image(src=url_for(cover) alt=title)
              else
                .post-card__image.post-card__image--bg(style=`background: ${cover}`)
            .post-card__overlay
            .post-card__pointer
            p.post-card__summary= summary

          .post-card__body
            h2.post-card__title
              if article.top || article.sticky > 0
                i.fas.fa-thumbtack.post-card__sticky
              span= title

            .post-card__meta
              span.post-card__meta-item
                i.far.fa-calendar-alt
                span= ` 发布于 ${date(article.date, config.date_format)}`
              if article.updated
                span.post-card__meta-divider |
                span.post-card__meta-item
                  i.fas.fa-history
                  span= ` 更新于 ${date(article.updated, config.date_format)}`

            if article.categories && article.categories.data.length > 0 || article.tags && article.tags.data.length > 0
              .post-card__footer
                if article.categories && article.categories.data.length > 0
                  each item in article.categories.data.slice(0, 1)
                    span.post-card__chip
                      i.fas.fa-folder-open
                      span= item.name
                if article.tags && article.tags.data.length > 0
                  each item in article.tags.data.slice(0, 2)
                    span.post-card__chip.post-card__chip--ghost
                      i.fas.fa-tag
                      span= item.name

    include includes/pagination.pug
