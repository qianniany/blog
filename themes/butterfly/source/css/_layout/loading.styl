if hexo-config('preloader.enable') && hexo-config('preloader.source') == 1
  #body-wrap
    opacity: 1

  html.page-reveal-ready
    #body-wrap
      opacity: 1
      filter: blur(10px)
      transform: scale(1.015)
      transition: transform .72s cubic-bezier(.22, 1, .36, 1), filter .55s ease, opacity .35s ease
      will-change: transform, filter

  @supports (clip-path: inset(0 50% 0 50%))
    html.page-reveal-ready
      #body-wrap
        clip-path: inset(0 50% 0 50%)
        transition: clip-path .72s cubic-bezier(.22, 1, .36, 1), transform .72s cubic-bezier(.22, 1, .36, 1), filter .55s ease, opacity .35s ease
        will-change: clip-path, transform, filter

  html.page-reveal-done
    #body-wrap
      filter: blur(0)
      transform: scale(1)

  @supports (clip-path: inset(0 50% 0 50%))
    html.page-reveal-done
      #body-wrap
        clip-path: inset(0 0 0 0)

  #loading-box
    position: fixed
    inset: 0
    z-index: 1000
    overflow: hidden
    background-color: #090b12

    .loading-overlay
      position: fixed
      inset: 0
      background-image: linear-gradient(180deg, rgba(6, 10, 18, .38), rgba(6, 10, 18, .62)), var(--loading-bg)
      background-position: center
      background-size: cover
      transform: scale(1.02)

      &:before
        position: absolute
        inset: 0
        background: radial-gradient(circle at center, rgba(255,255,255,.04), transparent 42%)
        content: ''

    .loading-progress-shell
      position: fixed
      top: 12px
      left: 50%
      z-index: 1002
      width: 78px
      transform: translateX(-50%)

    .loading-progress-track
      overflow: hidden
      width: 100%
      height: 6px
      border-radius: 999px
      background: rgba(255, 255, 255, .72)
      box-shadow: 0 4px 22px rgba(0, 0, 0, .22)

    .loading-progress-bar
      width: 100%
      height: 100%
      border-radius: inherit
      background: linear-gradient(90deg, #36bdfa, #8ee7ff)
      transform: scaleX(0)
      transform-origin: left center
      transition: transform .18s ease

    .loading-center
      position: fixed
      top: 50%
      left: 50%
      z-index: 1002
      text-align: center
      transform: translate(-50%, -50%)

    .loading-title
      margin-bottom: 14px
      color: rgba(255, 255, 255, .96)
      font-weight: 700
      font-size: 2rem
      letter-spacing: .03em
      text-shadow: 0 6px 22px rgba(0, 0, 0, .32)

    .loading-status
      display: inline-flex
      gap: 10px
      align-items: center
      justify-content: center
      padding: 7px 14px
      border: 1px solid rgba(255, 255, 255, .12)
      border-radius: 999px
      background: rgba(12, 16, 28, .22)
      color: rgba(255, 255, 255, .76)
      font-size: .82rem
      letter-spacing: .08em
      backdrop-filter: blur(10px)
      -webkit-backdrop-filter: blur(10px)

    &.loaded
      pointer-events: none
      opacity: 0
      visibility: hidden
      transition: opacity .5s ease, visibility .5s ease

      .loading-overlay
        transform: scale(1.05)
        transition: transform .7s ease, opacity .5s ease

      .loading-center,
      .loading-progress-shell
        opacity: 0
        transform: translate(-50%, calc(-50% + 14px))
        transition: opacity .35s ease, transform .45s ease

      .loading-progress-shell
        transform: translateX(-50%) translateY(-10px)

  +maxWidth768()
    @supports (clip-path: inset(0 50% 0 50%))
      html.page-reveal-ready
        #body-wrap
          clip-path: inset(0 48% 0 48%)

    #loading-box
      .loading-title
        font-size: 1.6rem

      .loading-status
        font-size: .72rem
